# Pick an order to check equipment slots for stealing
# @s = #gm4_reeling_rods:steal_equipment
# at bobber in @s
# run from hooked_entity/select_type & reeling/villager/action

SLOTS = [
  {name: "mainhand", prefix: "weapon"},
  {name: "head", prefix: "armor"},
  {name: "legs", prefix: "armor"},
  {name: "offhand", prefix: "weapon"},
  {name: "chest", prefix: "armor"},
  {name: "feet", prefix: "armor"}
]

execute store result score $order gm4_reeling_rods.math run random value (1, len(SLOTS))

for start_index in range(len(SLOTS)):
  order_number = start_index + 1
  execute if score $order gm4_reeling_rods.math matches order_number run return run function f"gm4_reeling_rods:reeling/stealable/order/equipment_{order_number}"
  function f"gm4_reeling_rods:reeling/stealable/order/equipment_{order_number}":
    raw f"# order {order_number}"
    raw # Generated by bolt
    for slot in SLOTS[start_index:] + SLOTS[:start_index]:
      steal_slot_predicate_tag = {"type": "minecraft:all_of", "terms": f"#gm4_reeling_rods:reeling/steal_slot/{slot.name}"}
      execute if items entity @s f"{slot.prefix}.{slot.name}" * if predicate steal_slot_predicate_tag run return run function f"gm4_reeling_rods:reeling/stealable/steal_slot/{slot.name}"
    return fail
