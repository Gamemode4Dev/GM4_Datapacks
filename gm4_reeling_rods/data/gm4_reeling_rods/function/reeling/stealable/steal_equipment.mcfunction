# Pick an order to check equipment slots for stealing
# @s = #gm4_reeling_rods:steal_equipment
# at bobber in @s
# run from hooked_entity/select_type & reeling/villager/action

SLOTS = [
  {slot: "mainhand", prefix: "weapon"},
  {slot: "head", prefix: "armor"},
  {slot: "legs", prefix: "armor"},
  {slot: "offhand", prefix: "weapon"},
  {slot: "chest", prefix: "armor"},
  {slot: "feet", prefix: "armor"}
]

execute store result score $order gm4_reeling_rods.math run random value (1, len(SLOTS))

for START_INDEX in range(len(SLOTS)):
  ORDER = START_INDEX + 1
  execute if score $order gm4_reeling_rods.math matches ORDER run return run function f"gm4_reeling_rods:reeling/stealable/order/equipment_{ORDER}"
  function f"gm4_reeling_rods:reeling/stealable/order/equipment_{ORDER}":
    raw f"# order {ORDER}"
    raw # Generated by bolt
    for SLOT in SLOTS[START_INDEX:] + SLOTS[:START_INDEX]:
      PASS_PREDICATE = {"type": "minecraft:all_of", "terms": f"#gm4_reeling_rods:reeling/steal_slot/{SLOT.slot}"}
      execute if items entity @s f"{SLOT.prefix}.{SLOT.slot}" * if predicate PASS_PREDICATE run return run function f"gm4_reeling_rods:reeling/stealable/steal_slot/{SLOT.slot}"
    return fail
